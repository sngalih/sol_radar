# ==========================================
# KONFIGURASI TELEGRAM BOT
# ==========================================
# Buat bot baru di Telegram melalui @BotFather untuk mendapatkan TELEGRAM_BOT_TOKEN
# Dapatkan ID chat Anda melalui @userinfobot untuk TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_ContohToken
TELEGRAM_CHAT_ID=123456789

# ==========================================
# PENGATURAN SCANNER & FILTER LP METEORA
# ==========================================
# Sumber data: GMGN (default, sama seperti Dashboard V5) atau METEORA
DATA_SOURCE=GMGN

# Interval pemindaian berkala (dalam detik, default 300 = 5 menit)
SCAN_INTERVAL=300

# Estimasi modal posisi LP (dalam USD, default $100)
POSITION_USD=100

# Minimal Likuiditas / TVL Pool (dalam USD, default $20,000)
MIN_LIQ=20000

# Minimal V/L (Volume 24h dibagi TVL, default 2.0x)
MIN_VL=2.0

# Maksimal Volatilitas Harga 5 Menit (dalam persen, default 15%)
MAX_5M=15.0

# Maksimal Volatilitas Harga 1 Jam (dalam persen, default 80%)
MAX_1H=80.0

# Maksimal Efficiency Ratio / ER (default 20.0)
MAX_ER=20.0

# Minimal Market Cap Token (dalam USD, default $500,000 / $500k)
MIN_MCAP=500000

# Minimal Estimasi Fee per Jam untuk kategori Siap LP (default $3.0/jam)
MIN_FEE_SIAP_LP=3.0

